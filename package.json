{
  "name": "@yitian951012/dsh-project-dev-flow",
  "version": "2.1.2",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "description": "证据驱动的项目开发流程插件：DSH bundle + agent preset + 5 个技能 + 方法/模板/案例资产",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "agent-preset",
    "project-workflow",
    "documentation-governance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yitian951012/dsh-project-dev-flow.git"
  },
  "homepage": "https://github.com/yitian951012/dsh-project-dev-flow#readme",
  "bugs": {
    "url": "https://github.com/yitian951012/dsh-project-dev-flow/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "skills",
    "methods",
    "templates",
    "cases",
    "config",
    "references",
    "evidence",
    "scripts",
    "tests",
    "locale",
    "detail",
    "icon.svg",
    "sources.lock.json",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "AUTHORING.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0",
    "node": ">=24.22.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "validate": "node scripts/validate-package.mjs",
    "check:sources": "node scripts/check-sources.mjs --require-docs",
    "check:sources:portable": "node scripts/check-sources.mjs",
    "check:patch": "node scripts/check-patch-yaml.mjs",
    "check:patch:ci": "node scripts/check-patch-yaml.mjs --require-yaml",
    "gen:sources": "node scripts/gen-sources-lock.mjs",
    "test": "node --test tests/validate-package.test.mjs tests/check-patch-yaml.test.mjs tests/section.test.mjs tests/contract-consistency.test.mjs",
    "test:source": "node --test tests/source-integration.test.mjs",
    "pack:dry": "npm pack --dry-run --json --ignore-scripts",
    "verify": "node scripts/verify.mjs",
    "smoke:profile": "node scripts/smoke-profile.mjs",
    "acceptance": "node scripts/acceptance-session.mjs",
    "evidence": "node scripts/release-evidence.mjs",
    "metrics": "node scripts/metrics.mjs"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
